# Configurações da Aplicação - Armazém Parada Obrigatória

# Porta do servidor
PORT=3000

# Ambiente de execução
NODE_ENV=development

# Banco de dados SQLite
DB_PATH=./database/ecommerce.db

# Chave de API (opcional - se usar Groq ou OpenAI)
GROQ_API_KEY=sua_chave_aqui
OPENAI_API_KEY=sua_chave_aqui

# Debug mode
DEBUG=false

# Modo de teste
TEST_MODE=false
