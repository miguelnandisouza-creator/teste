# Exemplo de variáveis de ambiente
# Copie este arquivo para .env e configure os valores

# Porta do servidor (Render define automaticamente)
PORT=3000

# Ambiente
NODE_ENV=development

# Banco de dados (quando migrar de SQLite)
DATABASE_URL=postgresql://seu-usuario:sua-senha@localhost:5432/seu-banco

# Outras configurações
DEBUG=false
